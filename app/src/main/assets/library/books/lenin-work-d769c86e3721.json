86e3721-chapter-001-d769c86e37-section-007-0f2ede59","parentId":"toc-lenin-work-d769c86e3721-chapter-chapter-001-d769c86e37","title":"11、公社的经济措施：","type":"SECTION","order":6,"chapterId":"chapter-001-d769c86e37","paragraphIndex":28,"counterpartKey":"chapter-1-section-7","level":3},{"id":"toc-lenin-work-d769c86e3721-chapter-001-d769c86e37-section-008-539807f5","parentId":"toc-lenin-work-d769c86e3721-chapter-chapter-001-d769c86e37","title":"（1）","type":"SECTION","order":7,"chapterId":"chapter-001-d769c86e37","paragraphIndex":29,"counterpartKey":"chapter-1-section-8","level":3},{"id":"toc-lenin-work-d769c86e3721-chapter-001-d769c86e37-section-009-05390322","parentId":"toc-lenin-work-d769c86e3721-chapter-chapter-001-d769c86e37","title":"（2）","type":"SECTION","order":8,"chapterId":"chapter-001-d769c86e37","paragraphIndex":31,"counterpartKey":"chapter-1-section-9","level":3},{"id":"toc-lenin-work-d769c86e3721-chapter-001-d769c86e37-section-010-b489d29d","parentId":"toc-lenin-work-d769c86e3721-chapter-chapter-001-d769c86e37","title":"（3）","type":"SECTION","order":9,"chapterId":"chapter-001-d769c86e37","paragraphIndex":33,"counterpartKey":"chapter-1-section-10","level":3},{"id":"toc-lenin-work-d769c86e3721-chapter-001-d769c86e37-section-011-b145e64b","parentId":"toc-lenin-work-d769c86e3721-chapter-chapter-001-d769c86e37","title":"（4）","type":"SECTION","order":10,"chapterId":"chapter-001-d769c86e37","paragraphIndex":36,"counterpartKey":"chapter-1-section-11","level":3}]}]}