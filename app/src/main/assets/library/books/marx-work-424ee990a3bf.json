01-424ee990a3","paragraphIndex":40,"counterpartKey":"chapter-1-section-18","level":3},{"id":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-019-c46b36f9","parentId":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-013-6922bdd9","title":"六","type":"SECTION","order":18,"chapterId":"chapter-001-424ee990a3","paragraphIndex":42,"counterpartKey":"chapter-1-section-19","level":3},{"id":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-020-8711577c","parentId":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-013-6922bdd9","title":"七","type":"SECTION","order":19,"chapterId":"chapter-001-424ee990a3","paragraphIndex":47,"counterpartKey":"chapter-1-section-20","level":3},{"id":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-021-22ae5b56","parentId":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-013-6922bdd9","title":"八","type":"SECTION","order":20,"chapterId":"chapter-001-424ee990a3","paragraphIndex":49,"counterpartKey":"chapter-1-section-21","level":3},{"id":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-022-b9cae988","parentId":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-013-6922bdd9","title":"九","type":"SECTION","order":21,"chapterId":"chapter-001-424ee990a3","paragraphIndex":51,"counterpartKey":"chapter-1-section-22","level":3},{"id":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-023-43f5a366","parentId":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-013-6922bdd9","title":"十","type":"SECTION","order":22,"chapterId":"chapter-001-424ee990a3","paragraphIndex":53,"counterpartKey":"chapter-1-section-23","level":3},{"id":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-024-79982334","parentId":"toc-marx-work-424ee990a3bf-chapter-001-424ee990a3-section-013-6922bdd9","title":"十一","type":"SECTION","order":23,"chapterId":"chapter-001-424ee990a3","paragraphIndex":55,"counterpartKey":"chapter-1-section-24","level":3}]}]}